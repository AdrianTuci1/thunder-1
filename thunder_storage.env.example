# Configurare Cloudflare R2 pentru Thunder dLLM - FULL ENV
# Creează un fișier .env pe serverul Vultr/DigitalOcean și adaugă aceste valori

# 1. Bucket și Endpoint
THUNDER_R2_BUCKET="numele-bucket-ului-tau"
THUNDER_R2_ENDPOINT="https://id-ul-tau-cloudflare.r2.cloudflarestorage.com"
THUNDER_R2_REGION="auto"

# 2. Credențiale (Manage R2 API Tokens)
THUNDER_R2_ACCESS_KEY="INTRODUCE_AICI_ACCESS_KEY_ID"
THUNDER_R2_SECRET_KEY="INTRODUCE_AICI_SECRET_ACCESS_KEY"

# 3. Monitorizare (Weights & Biases)
# Obține cheia de aici: https://wandb.ai/authorize
WANDB_API_KEY="INTRODUCE_AICI_CHEIA_WANDB"
